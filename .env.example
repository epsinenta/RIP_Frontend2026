VITE_BASE_PATH=/
VITE_DEV_API_PROXY=http://127.0.0.1:8080
# Локальная разработка: backend на этой же машине (http://127.0.0.1:8080 или http://localhost:8080).
# Оставь VITE_API_ORIGIN пустым, чтобы frontend бился в /api, а Vite проксировал на VITE_DEV_API_PROXY.
# ВАЖНО: если сайт открыт с https://*.github.io, браузер блокирует вызовы к http://localhost/127.0.0.1 (mixed content).
# Поэтому GitHub Pages не может стабильно работать с локальным backend; нужен публичный HTTPS API или HTTPS туннель.
VITE_API_ORIGIN=
VITE_MINIO_PUBLIC_BASE=http://localhost:9000/test
