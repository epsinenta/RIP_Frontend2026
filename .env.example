VITE_BASE_PATH=/
VITE_DEV_API_PROXY=http://localhost:8000
# Пустой VITE_API_ORIGIN → axios base = "/api" (относительно текущего хоста). На GitHub Pages без донастройки это github.io/api.
# Для Pages в CI задаётся vars.VITE_API_ORIGIN → scripts/postbuild-pages-api.mjs пишет dist/runtime-config.json и патчит бандл.
# С https://*.github.io нельзя вызывать http://localhost (mixed content) — нужен публичный HTTPS API или туннель.
VITE_API_ORIGIN=
VITE_MINIO_PUBLIC_BASE=http://localhost:9000/test
