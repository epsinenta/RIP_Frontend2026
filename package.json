{
  "name": "web_frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:tauri": "cross-env VITE_BASE_PATH=/ vite build",
    "lint": "eslint .",
    "generate-api": "node scripts/generate-api.mjs",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "tauri": "tauri",
    "tauri:precheck": "cargo --version",
    "tauri:dev": "tauri dev",
    "tauri:dev:local": "dotenv -e .env.tauri.local -- tauri dev",
    "tauri:build": "npm run build:tauri && tauri build",
    "tauri:build:local": "dotenv -e .env.tauri.local -- npm run build:tauri && tauri build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.1",
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.15.0",
    "bootstrap": "^5.3.8",
    "react": "^19.1.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tauri-apps/cli": "^2.9.4",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0",
    "swagger-typescript-api": "^13.2.16",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vite-plugin-mkcert": "^2.0.0",
    "vite-plugin-pwa": "^1.1.0"
  }
}
