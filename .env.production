VITE_BASE_PATH=/org-structure-frontend/
# Для локальной production-сборки на своей машине можно поставить:
# VITE_API_ORIGIN=http://127.0.0.1:8080 (или http://localhost:8080)
# Для GitHub Pages (https://*.github.io) такие URL браузер блокирует как mixed content.
# Поэтому для Pages оставляй пусто (относительный /api) или указывай публичный HTTPS backend.
VITE_API_ORIGIN=
VITE_MINIO_PUBLIC_BASE=
